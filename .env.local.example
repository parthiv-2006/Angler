# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── AI provider ────────────────────────────────────────────────────────────────
# Get from console.anthropic.com (pay-per-token API key, NOT a subscription token)
ANTHROPIC_API_KEY=sk-ant-...

# Optional Gemini fallback (Google AI Studio — free tier, no card)
GEMINI_API_KEY=...
AI_PROVIDER=anthropic   # "anthropic" | "gemini"

# ── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-side only, never expose to client

# ── Competitor data ────────────────────────────────────────────────────────────
APIFY_TOKEN=apify_api_...

# ── Demo ───────────────────────────────────────────────────────────────────────
DEMO_MODE=true   # "true" → seed verticals load instantly from cache
